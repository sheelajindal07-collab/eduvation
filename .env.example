# BCION Lite — environment variables (names only; real values live in the
# provider dashboard / your local shell, never in this repo).
# See docs/SECURITY.md and docs/DECISIONS.md ("Hosting ... not yet
# provisioned") for what each of these is and its data-residency note.

# --- App ---
APP_ENV=development                # development | staging | production
APP_SECRET_KEY=                    # session/cookie signing; generate locally

# --- Supabase (Mumbai region) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=               # server-only, verifies user tokens — never expose to a browser
SUPABASE_SERVICE_ROLE_KEY=         # TEST-ONLY: tests/db/ uses this to create/tear down throwaway
                                    # test users (guest/student A/student B/reviewer). The running
                                    # app never reads this var — see app/db/client.py and
                                    # docs/SECURITY.md ("never the owner/service role for a
                                    # user-facing request"). Leave unset outside a test environment.
DATABASE_URL=                      # OPS-ONLY: scripts/apply_migrations.py uses this direct Postgres
                                    # connection string to apply db/migrations/*.sql. Find it at
                                    # Project Settings -> Database -> Connection string -> URI (fill
                                    # in the password yourself). The running app NEVER reads this —
                                    # schema-level authority must never sit in a user-facing request
                                    # (docs/SECURITY.md). Leave unset outside a migration run.

# --- AI provider (Gemini, per docs/DECISIONS.md owner confirmation; adapter-based, swappable) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MONTHLY_SPEND_CAP_INR=5000      # Lite Build Pack §11 budget: ₹1,000-5,000/month at Hindi-adjusted volumes
AI_REQUEST_TIMEOUT_SECONDS=15

# --- WhatsApp Cloud API (opt-in deadline reminders only; optional for Lite) ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Monitoring (choose one when provisioned; region goes in docs/SECURITY.md) ---
ERROR_TRACKING_DSN=
UPTIME_CHECK_URL=

# --- n8n (workflow glue, off the request path) ---
N8N_WEBHOOK_URL=

# BCION Lite — environment variables (names only; real values live in the
# provider dashboard / your local shell, never in this repo).
# See docs/SECURITY.md and docs/DECISIONS.md ("Hosting ... not yet
# provisioned") for what each of these is and its data-residency note.

# --- App ---
APP_ENV=development                # development | staging | production
APP_SECRET_KEY=                    # session/cookie signing; generate locally

# --- Supabase (Mumbai region) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=               # server-only, verifies user tokens — never expose to a browser
SUPABASE_SERVICE_ROLE_KEY=         # TEST-ONLY: tests/db/ uses this to create/tear down throwaway
                                    # test users (guest/student A/student B/reviewer). The running
                                    # app never reads this var — see app/db/client.py and
                                    # docs/SECURITY.md ("never the owner/service role for a
                                    # user-facing request"). Leave unset outside a test environment.
DATABASE_URL=                      # OPS-ONLY: scripts/apply_migrations.py uses this direct Postgres
                                    # connection string to apply db/migrations/*.sql. Find it at
                                    # Project Settings -> Database -> Connection string -> URI (fill
                                    # in the password yourself). The running app NEVER reads this —
                                    # schema-level authority must never sit in a user-facing request
                                    # (docs/SECURITY.md). Leave unset outside a migration run.

# --- AI provider (Gemini, per docs/DECISIONS.md owner confirmation; adapter-based, swappable) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=                           # AI model identifier (e.g. "gemini-1.5-pro")
AI_MAX_INPUT_TOKENS=                # maximum input tokens per request
AI_MAX_OUTPUT_TOKENS=               # maximum output tokens per request
AI_PER_ACCOUNT_DAILY_CAP=           # per-account daily request cap
AI_MONTHLY_SPEND_CAP_INR=5000      # Lite Build Pack §11 budget: ₹1,000-5,000/month at Hindi-adjusted volumes
AI_REQUEST_TIMEOUT_SECONDS=15
AI_DAILY_REQUEST_BUDGET=200         # app/ai/budget.py in-memory circuit breaker; request COUNT, not money

# --- WhatsApp Cloud API (opt-in deadline reminders only; optional for Lite) ---
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Monitoring (choose one when provisioned; region goes in docs/SECURITY.md) ---
ERROR_TRACKING_DSN=
UPTIME_CHECK_URL=

# --- n8n (workflow glue, off the request path) ---
N8N_WEBHOOK_URL=

# --- Guardian-consent confirmation link (app/api/guardian_consent.py) ---
APP_BASE_URL=http://localhost:8000  # public origin used to build the GET /consent/confirm link in the guardian email

# --- Email sending (app/notifications/) ---
# UNSET IN EVERY ENVIRONMENT TODAY. Until all three are set, guardian-
# consent emails only ever reach the app's own log output
# (app/notifications/logging_sender.py) -- no real inbox is reached.
# Any provider's SMTP relay endpoint works here (SendGrid/SES/Mailgun/
# Resend/a plain mailbox); this is an owner action (provision the
# account, then fill these in your own .env -- never in chat).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Feature flags / kill switches (DEPLOY-18) ---
# docs/CONTRACTS.md "the flag list, and only this list". Every flag here
# fails CLOSED: unset, blank or an unrecognised value is always read as
# off/empty, never as enabled or "allow anything" -- never set any of
# these to a garbled value expecting it to behave like "on".
# `SIGNUPS_ENABLED` (with an S) is a stale name from an earlier draft and
# must never be reintroduced.
SIGNUP_ENABLED=false               # public sign-up; closed until explicitly opted in
MAINTENANCE_MODE=false             # kill switch: true pauses every route except /healthz
AI_ENABLED=false                   # operator toggle for AI-backed features (separate from GEMINI_API_KEY being set)
HINDI_UI_ENABLED=false             # Hindi UI/copy variant
ALLOWED_HOSTS=                     # comma-separated hostnames for TrustedHostMiddleware; empty outside
                                    # development means no Host header is valid yet (fail closed, never "*")
MINOR_ACCOUNTS_ENABLED=false       # CLAUDE.md: real minor accounts stay disabled until the consent/
                                    # safeguarding workflow is reviewed by a person
DEMO_MODE=false                    # reserved guard for a supervised demo/showcase run; not yet wired to
                                    # any behaviour (DEPLOY-18 only adds the flag)

# BCION Lite — environment for the TEST SUITES ONLY (QA-2).
#
# Copy to `.env.test` (never committed) — or, far better, just run
# `make test-db-up`, which writes `.env.test` for you from the running
# local stack. Names only here, exactly like `.env.example`; the real
# `.env` (the owner's live Supabase project) is a different file, lives
# outside this repo, and must never be read, copied or recreated by a
# test run.
#
# WHO READS THIS FILE
#   `tests/db/conftest.py` loads `.env.test`, then `.env.test.local`,
#   into the environment before the app's settings are constructed —
#   so a plain `pytest tests/db` picks it up, not only `make test-db`.
#   Values in these files deliberately OVERRIDE whatever is already
#   exported in your shell: the whole point is that a live
#   `SUPABASE_URL` lingering in a terminal cannot leak into a test run.
#
# THE TARGET GUARD
#   Whatever ends up in `SUPABASE_URL`, `tests/db/conftest.py` aborts
#   the entire run — before a single row is written — unless the host is
#   a loopback address. Pointing this at a real project does not "work
#   with a warning"; it fails the run.
#
# ---------------------------------------------------------------------

# --- App ---
# `development` keeps app/main.py's boot check in its permissive branch
# (see create_app) and makes ALLOWED_HOSTS default to "*", which the
# ephemeral-port e2e server needs.
APP_ENV=development
# Not a secret and not a placeholder to fill in: no test in this repo
# verifies a real signature, and this value only ever signs cookies on a
# loopback stack. Same string `make test-db-env` generates, so a
# hand-copied file and a generated one behave identically.
APP_SECRET_KEY=local-test-only-not-a-secret

# --- Local Supabase stack (supabase/config.toml, `supabase start`) ---
# MUST be loopback. 127.0.0.1 / localhost / ::1 only — the guard rejects
# every other host. The port is supabase/config.toml's `[api] port`.
SUPABASE_URL=http://127.0.0.1:54321
# The three keys below are the Supabase CLI's fixed local demo keys.
# They are printed by `supabase status`, are byte-identical on every
# machine in the world, and authenticate against nothing but this
# loopback stack — they are not secrets and are not the live project's
# keys. Left blank here anyway, so this file stays "names only" and
# there is never a template for someone to paste a real key into.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
# TEST-ONLY, same contract as .env.example: used solely by
# tests/db/conftest.py to create and delete throwaway users. The running
# app never reads it.
SUPABASE_SERVICE_ROLE_KEY=

# OPS-ONLY: the local stack's direct Postgres connection, used by
# `make test-db-up` to run scripts/apply_migrations.py and then issue
# NOTIFY pgrst, 'reload schema'. Loopback, and the local stack's
# password is the CLI's fixed `postgres`. Never a remote host.
DATABASE_URL=

# --- Test-harness switches (read by tests/db/conftest.py) ---
# 1 = every "not configured" / "migration not applied" skip becomes a
# hard failure instead. Set this in CI and before a merge: it is the
# difference between "the suite passed" and "the suite actually ran".
# Unset/0 locally keeps the friendly skips.
BCION_REQUIRE_LIVE=0
# Escape hatch for a non-loopback target, as a comma-separated list of
# exact `scheme://host:port` origins. Empty, and it must normally stay
# empty. Intended for a future disposable staging database that the
# owner has explicitly approved — NEVER for the live project, which
# holds real student data (CLAUDE.md). An entry here does not disable
# any other safety check; it only stops the guard from aborting.
BCION_TEST_TARGET=

# --- Deliberately left unset ---
# GEMINI_API_KEY, SMTP_*, WHATSAPP_*, N8N_WEBHOOK_URL, ERROR_TRACKING_DSN
# No test in this repo makes a paid AI call, sends an email, or reaches
# any third party. Setting them here would be the only way that could
# start happening by accident, so don't. Feature flags are likewise left
# at their fail-closed defaults (app/core/config.py) unless a specific
# test needs one.

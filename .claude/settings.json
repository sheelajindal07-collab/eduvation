{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat .env.local)",
      "Bash(type .env)",
      "Bash(type .env.local)",
      "Bash(more .env)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(Get-Content .env)",
      "Bash(Get-Content .env.local)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(set)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git worktree*)",
      "Bash(python -m pytest*)",
      "Bash(python -m ruff*)",
      "Bash(python -m mypy*)",
      "Bash(npm ci)",
      "Bash(npm run*)"
    ]
  }
}
